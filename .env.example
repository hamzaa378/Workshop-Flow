# Copy to .env and customize. Local development only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gdg_workshops
MYSQL_USER=root
MYSQL_PASSWORD=change_me
DJANGO_SECRET_KEY=replace_this_with_a_long_random_secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
API_BASE_URL=http://127.0.0.1:8000
MOCK_BASE_URL=http://127.0.0.1:9100
MOCK_SHARED_SECRET=replace_me_with_another_random_secret
MOCK_DB_PATH=mock_service/mock_notifications.sqlite3
NOTIFY_HTTP_TIMEOUT=1.3
NOTIFY_LEASE_SECONDS=15
NOTIFY_POLL_INTERVAL=1.0
NOTIFY_BATCH_SIZE=20
